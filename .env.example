# Postgres connection string (Vercel: Storage -> Neon sets this for you)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Password for /admin
ADMIN_PASSWORD="change-me"

# Random string used to sign login cookies. Generate: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Default approval mode before you pick one in /admin: "true" = auto-approve, "false" = manual
AUTO_APPROVE_DEFAULT="false"

# In manual mode, edits to an approved listing send it back for approval ("true"), or keep it live ("false")
REQUIRE_REAPPROVAL_ON_EDIT="true"

NEXT_PUBLIC_SITE_NAME="Neighborhood Market"
NEXT_PUBLIC_CURRENCY="USD"
