# Postgres connection string (Vercel: Storage -> Neon sets this for you)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Password for /admin
ADMIN_PASSWORD="change-me"

# Random string used to sign login cookies. Generate: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Default approval mode before you pick one in /admin: "true" = auto-approve, "false" = manual
AUTO_APPROVE_DEFAULT="false"

# In manual mode, edits to an approved listing send it back for approval ("true"), or keep it live ("false")
REQUIRE_REAPPROVAL_ON_EDIT="true"

# Optional: only let people with these email domains create an account (comma separated). Leave empty to allow any email.
# Example: "psu.edu" also allows subdomains such as "student.psu.edu"
SIGNUP_ALLOWED_EMAIL_DOMAINS=""

# Optional: turns on the AI helpers. Without any key the site still works: it uses simple built-in rules instead of AI.
# Paid: Anthropic (console.anthropic.com). Used by the Help chat and by "Quick post with AI".
ANTHROPIC_API_KEY=""
# Free to start: Google Gemini (aistudio.google.com, "Get API key"). Used by "Quick post with AI" only.
GEMINI_API_KEY=""
# Optional: which one Quick post uses when both keys exist: "gemini" or "anthropic" (default: Anthropic if its key is set)
AI_PROVIDER=""
# Optional: most AI listing drafts the whole site makes per day (default 15 with Gemini free, 200 with Anthropic)
AI_LISTING_DAILY_LIMIT="200"
# Optional: describes your area to the AI so it recognizes local places (default: State College, Pennsylvania)
SITE_AREA=""

NEXT_PUBLIC_SITE_NAME="Neighborhood Market"
NEXT_PUBLIC_CURRENCY="USD"
