# Postgres connection string (Vercel: Storage -> Neon sets this for you)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Password for /admin
ADMIN_PASSWORD="change-me"

# Random string used to sign login cookies. Generate: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Default approval mode before you pick one in /admin: "true" = auto-approve, "false" = manual
AUTO_APPROVE_DEFAULT="false"

# In manual mode, edits to an approved listing send it back for approval ("true"), or keep it live ("false")
REQUIRE_REAPPROVAL_ON_EDIT="true"

# Optional: only let people with these email domains create an account (comma separated). Leave empty to allow any email.
# Example: "psu.edu" also allows subdomains such as "student.psu.edu"
SIGNUP_ALLOWED_EMAIL_DOMAINS=""

# Optional: turns on the AI helpers (the Help chat and "Quick post with AI"). Get a key at console.anthropic.com.
# Without it the site still works: it uses simple built-in rules instead of AI.
ANTHROPIC_API_KEY=""
# Optional: most AI listing drafts the whole site will make per day (default 200)
AI_LISTING_DAILY_LIMIT="200"

NEXT_PUBLIC_SITE_NAME="Neighborhood Market"
NEXT_PUBLIC_CURRENCY="USD"
