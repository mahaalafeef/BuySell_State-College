generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  PENDING // waiting for the admin to approve it
  APPROVED // available
  SALE_PENDING // the seller has a buyer lined up (set by the seller)
  REJECTED
  SOLD
}

model Listing {
  id              String        @id @default(cuid())
  listingNumber   Int           @default(autoincrement()) // public post number (shown as BSC-0001), never repeats
  title           String
  description     String
  priceCents      Int
  category        String
  condition       String
  location        String
  imageUrl        String? // cover photo (first of `images`)
  images          String[]      @default([])
  contact         String // shown publicly: how buyers reach the seller
  whatsapp        String? // public: WhatsApp number (digits with country code) or username
  phone           String // private: last 10 digits, used to prove ownership
  passcodeHash    String // private: scrypt hash
  status          ListingStatus @default(PENDING)
  rejectionReason String?
  failedAttempts  Int           @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // The member whose account this listing belongs to (empty for older listings until the seller proves ownership)
  ownerId         String?
  owner           JoinRequest?  @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([phone])
  @@index([listingNumber])
  @@index([ownerId])
}

// Simple key/value store for site settings (e.g. autoApprove)
model Setting {
  key   String @id
  value String
}

// Messages people leave for the team via the chat widget's "Talk to a person" form
model SupportRequest {
  id         String   @id @default(cuid())
  name       String
  contact    String // email or phone, how to reply
  message    String
  transcript String? // recent chatbot conversation, for context
  status     String   @default("OPEN") // OPEN or RESOLVED
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
}

// Used to limit how often one visitor can use the chatbot / contact form
model ChatEvent {
  id        String   @id @default(cuid())
  kind      String // "chat" or "support"
  ipHash    String
  createdAt DateTime @default(now())

  @@index([kind, ipHash, createdAt])
  @@index([createdAt])
}

// Requests to join the community WhatsApp group. The proof photo is private and deleted after review.
model JoinRequest {
  id          String    @id @default(cuid())
  name        String
  whatsapp    String // digits with country code, or a WhatsApp username
  role        String // how they are connected (student, resident, ...)
  note        String?
  proof       Bytes? // photo of their proof; set to null once the request is decided
  hasProof    Boolean   @default(false)
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  decidedNote String?
  passwordHash   String? // member's password (scrypt hash), set from their personal link
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  listings        Listing[] @relation("ListingOwner")
  reviewsReceived Review[]  @relation("SellerReviews")
  reviewsWritten  Review[]  @relation("ReviewAuthor")

  resetRequestedAt DateTime? // set when the member says they forgot their password
  @@index([status, createdAt])
}

// A member's star rating (1 to 5) and optional comment about a seller. One per member per seller.
model Review {
  id         String   @id @default(cuid())
  sellerId   String
  reviewerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  seller   JoinRequest @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  reviewer JoinRequest @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, reviewerId])
  @@index([sellerId, createdAt])
}
