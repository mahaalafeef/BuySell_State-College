generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  PENDING // waiting for the admin to approve it
  APPROVED // available
  SALE_PENDING // the seller has a buyer lined up (set by the seller)
  REJECTED
  SOLD
}

model Listing {
  id              String        @id @default(cuid())
  listingNumber   Int           @default(autoincrement()) // public post number (shown as BSC-0001), never repeats
  title           String
  description     String
  priceCents      Int
  category        String
  condition       String
  location        String
  imageUrl        String? // cover photo (first of `images`)
  images          String[]      @default([])
  contact         String // shown publicly: how buyers reach the seller
  whatsapp        String? // public: WhatsApp number (digits with country code) or username
  phone           String // private: last 10 digits, used to prove ownership
  passcodeHash    String // private: scrypt hash
  status          ListingStatus @default(PENDING)
  rejectionReason String?
  failedAttempts  Int           @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // The member whose account this listing belongs to (empty for older listings until the seller proves ownership)
  ownerId         String?
  owner           JoinRequest?  @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  conversations   Conversation[] @relation("ListingConversations")

  @@index([status, createdAt])
  @@index([phone])
  @@index([listingNumber])
  @@index([ownerId])
}

// Simple key/value store for site settings (e.g. autoApprove)
model Setting {
  key   String @id
  value String
}

// Messages people leave for the team via the chat widget's "Talk to a person" form
model SupportRequest {
  id         String   @id @default(cuid())
  name       String
  contact    String // email or phone, how to reply
  message    String
  transcript String? // recent chatbot conversation, for context
  status     String   @default("OPEN") // OPEN or RESOLVED
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
}

// Used to limit how often one visitor can use the chatbot / contact form
model ChatEvent {
  id        String   @id @default(cuid())
  kind      String // "chat" or "support"
  ipHash    String
  createdAt DateTime @default(now())

  @@index([kind, ipHash, createdAt])
  @@index([createdAt])
}

// Requests to join the community WhatsApp group. The proof photo is private and deleted after review.
model JoinRequest {
  id          String    @id @default(cuid())
  name        String
  whatsapp    String? // digits with country code, or a WhatsApp username (empty for people who signed up with an email)
  email       String?   @unique // set for people who create their own account with an email and password
  role        String // how they are connected (student, resident, ...)
  note        String?
  proof       Bytes? // photo of their proof; set to null once the request is decided
  hasProof    Boolean   @default(false)
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED
  decidedNote String?
  passwordHash   String? // member's password (scrypt hash), set from their personal link
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  // When the member last asked for a password reset (cleared once the admin deals with it)
  resetRequestedAt DateTime?

  listings        Listing[] @relation("ListingOwner")
  reviewsReceived Review[]  @relation("SellerReviews")
  reviewsWritten  Review[]  @relation("ReviewAuthor")

  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  messagesSent          Message[]      @relation("MessageSender")

  @@index([status, createdAt])
}

// A member's star rating (1 to 5) and optional comment about a seller. One per member per seller.
model Review {
  id         String   @id @default(cuid())
  sellerId   String
  reviewerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  seller   JoinRequest @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  reviewer JoinRequest @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([sellerId, reviewerId])
  @@index([sellerId, createdAt])
}

// Daily visitor counts for the admin (no cookies, no IP addresses stored)
model DailyStat {
  day            String @id // "2026-11-18"
  visitors       Int    @default(0)
  memberVisitors Int    @default(0)
  views          Int    @default(0)
}

// Anonymous visitor codes, used only to count each visitor once a day (old ones are deleted)
model VisitorDay {
  id     String  @id @default(cuid())
  day    String
  hash   String
  member Boolean @default(false)

  @@unique([day, hash])
  @@index([day])
}

// A private conversation between one buyer and one seller about one listing. The admin can read every conversation.
model Conversation {
  id           String      @id @default(cuid())
  listingId    String?
  listing      Listing?    @relation("ListingConversations", fields: [listingId], references: [id], onDelete: SetNull)
  listingTitle String // saved so the admin still sees what it was about if the listing is later deleted
  buyerId      String
  sellerId     String
  buyer        JoinRequest @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller       JoinRequest @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerUnread  Boolean     @default(false) // the seller wrote something the buyer hasn't opened yet
  sellerUnread Boolean     @default(false) // the buyer wrote something the seller hasn't opened yet
  lastMessageAt DateTime   @default(now())
  createdAt    DateTime    @default(now())
  messages     Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         JoinRequest  @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
