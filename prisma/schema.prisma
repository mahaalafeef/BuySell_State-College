generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  SOLD
}

model Listing {
  id              String        @id @default(cuid())
  title           String
  description     String
  priceCents      Int
  category        String
  condition       String
  location        String
  imageUrl        String? // cover photo (first of `images`)
  images          String[]      @default([])
  contact         String // shown publicly: how buyers reach the seller
  whatsapp        String? // public: WhatsApp number (digits with country code) or username
  phone           String // private: last 10 digits, used to prove ownership
  passcodeHash    String // private: scrypt hash
  status          ListingStatus @default(PENDING)
  rejectionReason String?
  failedAttempts  Int           @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

// Simple key/value store for site settings (e.g. autoApprove)
model Setting {
  key   String @id
  value String
}

// Messages people leave for the team via the chat widget's "Talk to a person" form
model SupportRequest {
  id         String   @id @default(cuid())
  name       String
  contact    String // email or phone, how to reply
  message    String
  transcript String? // recent chatbot conversation, for context
  status     String   @default("OPEN") // OPEN or RESOLVED
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
}

// Used to limit how often one visitor can use the chatbot / contact form
model ChatEvent {
  id        String   @id @default(cuid())
  kind      String // "chat" or "support"
  ipHash    String
  createdAt DateTime @default(now())

  @@index([kind, ipHash, createdAt])
  @@index([createdAt])
}
