generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingStatus {
  PENDING
  APPROVED
  REJECTED
  SOLD
}

model Listing {
  id              String        @id @default(cuid())
  title           String
  description     String
  priceCents      Int
  category        String
  condition       String
  location        String
  imageUrl        String?
  contact         String // shown publicly: how buyers reach the seller
  phone           String // private: last 10 digits, used to prove ownership
  passcodeHash    String // private: scrypt hash
  status          ListingStatus @default(PENDING)
  rejectionReason String?
  failedAttempts  Int           @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

// Simple key/value store for site settings (e.g. autoApprove)
model Setting {
  key   String @id
  value String
}
